# Fastergamer API Worker —— 生产以本机 workerd 运行（systemd 托管）
# 线上实际部署名为 fastergamer-api.service，本文件与之保持一致
# 放置位置：/etc/systemd/system/fastergamer-api.service
# 启用：sudo systemctl daemon-reload && sudo systemctl enable --now fastergamer-api
#
# 生产目录 /home/wafer/fastergamer/ 结构（由 scripts/deploy-api-local.sh 生成）：
#   index.js      Worker 打包产物
#   config.capnp  workerd 配置（scripts/gen-workerd-config.mjs 生成）
#   kv/           KV 磁盘数据（TOKENS/PLANS/ORDERS/NODES，每 key 一个文件）
[Unit]
Description=Fastergamer API Worker (workerd production)
After=network.target

[Service]
Type=simple
User=wafer
Group=wafer
WorkingDirectory=/home/wafer/fastergamer
ExecStart=/home/wafer/cloudflare/node_modules/.bin/workerd serve /home/wafer/fastergamer/config.capnp
Restart=always
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
